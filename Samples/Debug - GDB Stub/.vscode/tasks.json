{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Compile [DEBUG]",
            "type": "shell",
            "command": "./compile.bat",
            "args": [
                "debug"
            ],
            "problemMatcher": [],
            "presentation": {
                "showReuseMessage": false,
                "clear": true
            },
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "Run on Saturn",
            "type": "shell",
            "command": "./run_on_saturn.bat",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "presentation": {
                "showReuseMessage": false,
                "clear": true
            },
            "group": {
                "kind": "test",
                "isDefault": false
            }
        },
        {
            "label": "Upload to Saturn",
            "type": "shell",
            "command": "bash ./../../tools/scripts/upload_to_saturn.sh",
            "windows": {
                "command": "powershell",
                "args": [
                    "-NoProfile",
                    "-File",
                    "./../../tools/scripts/upload_to_saturn.ps1"
                ],
                "options": {
                    "cwd": "${workspaceFolder}"
                }
            },
            "osx": {
                "command": "bash ./../../tools/scripts/upload_to_saturn.sh",
                "options": {
                    "cwd": "${workspaceFolder}",
                    "env": {
                        "PATH": "/opt/homebrew/bin:/usr/local/bin:${workspaceFolder}/../../tools/bin/mac/ftx:${workspaceFolder}/../../tools/bin/mac/usbreset:${env:PATH}"
                    }
                }
            },
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "presentation": {
                "showReuseMessage": false,
                "clear": true
            },
            "linux": {
                "options": {
                    "cwd": "${workspaceFolder}",
                    "env": {
                        "PATH": "${workspaceFolder}/../../tools/bin/lin/ftx:${env:PATH}"
                    }
                }
            }
        },
        {
            "label": "Upload and Start FTX",
            "dependsOrder": "sequence",
            "dependsOn": [
                "Upload to Saturn",
                "Start FTX"
            ],
            "problemMatcher": []
        },
        {
            "label": "Start FTX",
            "type": "shell",
            "command": "bash ./../../tools/scripts/start_ftx.sh",
            "windows": {
                "command": "powershell",
                "args": [
                    "-NoProfile",
                    "-File",
                    "./../../tools/scripts/start_ftx.ps1"
                ],
                "options": {
                    "cwd": "${workspaceFolder}"
                }
            },
            "osx": {
                "command": "bash ./../../tools/scripts/start_ftx.sh",
                "options": {
                    "cwd": "${workspaceFolder}",
                    "env": {
                        "PATH": "/opt/homebrew/bin:/usr/local/bin:${workspaceFolder}/../../tools/bin/mac/ftx:${workspaceFolder}/../../tools/bin/mac/usbreset:${env:PATH}"
                    }
                }
            },
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "presentation": {
                "showReuseMessage": false,
                "clear": true
            },
            "linux": {
                "options": {
                    "cwd": "${workspaceFolder}",
                    "env": {
                        "PATH": "${workspaceFolder}/../../tools/bin/lin/ftx:${env:PATH}"
                    }
                }
            }
        },
        {
            "label": "Connect to GDB",
            "type": "shell",
            "command": "bash ./../../tools/scripts/connect_gdb.sh",
            "windows": {
                "command": "powershell",
                "args": [
                    "-NoProfile",
                    "-File",
                    "./../../tools/scripts/connect_gdb.ps1"
                ],
                "options": {
                    "cwd": "${workspaceFolder}"
                }
            },
            "osx": {
                "command": "bash ./../../tools/scripts/connect_gdb.sh",
                "options": {
                    "cwd": "${workspaceFolder}",
                    "env": {
                        "PATH": "/opt/homebrew/bin:/usr/local/bin:${workspaceFolder}/../../tools/bin/mac/ftx:${workspaceFolder}/../../tools/bin/mac/usbreset:${env:PATH}"
                    }
                }
            },
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "presentation": {
                "showReuseMessage": false,
                "clear": true,
                "focus": true,
                "panel": "shared"
            },
            "linux": {
                "options": {
                    "cwd": "${workspaceFolder}",
                    "env": {
                        "PATH": "${workspaceFolder}/../../tools/bin/lin/ftx:${env:PATH}"
                    }
                }
            }
        }
    ]
}
