OUTPUT_FORMAT(elf32-sh)
SECTIONS {

	PRELOADER 0x06004000 : {
		___Preloader = .;
		*(PRELOADER)
	}

	SLSTART ALIGN(0x10): {
		___Start = .;
		*(SLSTART)
	}

	.text ALIGN(0x20) :
	{
		*(.text)
		*(.text*)
		*(.strings*)
		*("SEGA_P")

        __etext = .;
	}

	SLPROG ALIGN(0x20): {
		__slprog_start = .;
		*(SLPROG)
		__slprog_end = .;
	}

	.tors  ALIGN(0x10) :
	{
		___ctors = . ;
		*(.ctors*)
		___ctors_end = . ;
		___dtors = . ;
		*(.dtors*)
		___dtors_end = . ;
	}

	.data ALIGN(0x10):
	{
		*(.data)
		*(.data*)
        . = ALIGN(0x10);
		__edata = . ;
	}

	.rodata ALIGN(0x20) :
	{
		*(.rodata)
		*(.rodata*)
	}

	.bss ALIGN(0x10):
	{
		__bstart = . ;
		*(.bss)
		*(.bss*)
        *(COMMON)
        . = ALIGN(0x10);
		__bend = . ;
	}

	HEAP ALIGN(0x20):
	{
		__heap_start = .;
	}

	/* The heap spans up to the reserved system area: TransList (DMA
	 * transfer table) at 0x060FB800, master stack at 0x060FFC00.
	 * The SGL work area is allocated from the heap at boot by
	 * SRL::SglWorkArea::Install() — see srl_sgl_workarea.hpp.
	 */
	__heap_end = 0x060FB800;

    SYSTEM_START 0x060FB800 : {
        __systemStart = .;
    }

    SYSTEM_END 0x060FFC00 : {
        __systemEnd = .;
		_end = .;
    }

    /DISCARD/ :
    {
        *(.rela*)
        *(.rel.text .rel.data .rel.rodata)
        *(.rela.text .rela.data .rela.rodata)
        *(.rela.text.* .rela.data.*)
        *(.eh_frame)
		/* No longer produced — discard in case a stale object still
		 * carries them. */
		*(WORK_AREA*)
		*(COMMAND_BUF*)
    }
}
